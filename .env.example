# Shared/OnchainKit variables

# Environment (production for Base mainnet, development for Base Sepolia)
NEXT_PUBLIC_ENVIRONMENT=development

NEXT_PUBLIC_ONCHAINKIT_PROJECT_NAME=Seer
NEXT_PUBLIC_URL=https://your-app-url.vercel.app
NEXT_PUBLIC_ICON_URL=https://your-icon-url.com/icon.png
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key

# Frame metadata

FARCASTER_HEADER=your_farcaster_header
FARCASTER_PAYLOAD=your_farcaster_payload
FARCASTER_SIGNATURE=your_farcaster_signature
NEXT_PUBLIC_APP_ICON=https://your-app-icon-url.com/icon.png
# Optional Frame metadata items below
NEXT_PUBLIC_APP_SUBTITLE=Swipe-based social prediction markets
NEXT_PUBLIC_APP_DESCRIPTION=Predict with your crypto frens! Swipe to create and trade predictions on crypto, sports, and politics. Building the future of community predictions.
NEXT_PUBLIC_APP_SPLASH_IMAGE=https://your-splash-image-url.com/splash.png
NEXT_PUBLIC_SPLASH_BACKGROUND_COLOR="#000000"
NEXT_PUBLIC_APP_PRIMARY_CATEGORY=finance
NEXT_PUBLIC_APP_HERO_IMAGE=https://your-hero-image-url.com/hero.png
NEXT_PUBLIC_APP_TAGLINE=Social predictions for crypto frens
NEXT_PUBLIC_APP_OG_TITLE=Seer 🔮 - social prediction markets
NEXT_PUBLIC_APP_OG_DESCRIPTION=Swipe-based social prediction markets. Create and trade predictions by swiping.
NEXT_PUBLIC_APP_OG_IMAGE=https://your-og-image-url.com/og.png
NEXT_PUBLIC_APP_TAGS=prediction,crypto,trading,defi,swipe

# Redis config

REDIS_URL=your_redis_url
REDIS_TOKEN=your_redis_token

# Supabase config

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key for admin operations (optional, for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Coinbase Paymaster Configuration - Project Specific
# Your Coinbase Developer Platform endpoints
NEXT_PUBLIC_PAYMASTER_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/your_project_id
NEXT_PUBLIC_BUNDLER_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia/your_project_id

# Base Sepolia Configuration
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Private key for deployment (DO NOT commit this to version control)
# Get this from your wallet (MetaMask -> Account Details -> Export Private Key)
# Remove the 0x prefix if present
PRIVATE_KEY=your_private_key_here

# Base Sepolia RPC URL
# Get free RPC from Alchemy, Infura, or use public endpoint
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base Mainnet RPC URL (for production deployments)
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Basescan API key for contract verification (optional but recommended)
# Get from https://basescan.org/register
BASESCAN_API_KEY=your_basescan_api_key_here

# For testing purposes (fork URL)
FORK_URL=https://sepolia.base.org

# Wallet address (optional, for reference)
WALLET_ADDRESS=your_wallet_address_here