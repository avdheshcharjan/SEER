# Contract Deployment Environment Variables
# This file is specifically for Foundry/Solidity deployment scripts
# For Next.js app configuration, see the root .env.example file

# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Basescan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key

# RPC URLs (optional, defaults are set in foundry.toml)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# For testing purposes
FORK_URL=https://sepolia.base.org